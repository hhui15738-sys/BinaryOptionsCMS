APP_NAME=BinaryOptionsCMS
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_DOMAIN=127.0.0.1:8080
WEBSOCKET_HOST=127.0.0.1:6001

DB_CONNECTION=pgsql
PG_DB_HOST=postgres
PG_DB_PORT=5432
PG_DB_DATABASE=binaries
PG_DB_USERNAME=binaries
PG_DB_PASSWORD=change-this-postgres-password

MYSQL_DB_HOST=mysql
MYSQL_DB_PORT=3306
MYSQL_DB_DATABASE=binaries
MYSQL_DB_USERNAME=binaries
MYSQL_DB_PASSWORD=change-this-mysql-password
MYSQL_ROOT_PASSWORD=change-this-mysql-root-password

CLICKHOUSE_DB_HOST=clickhouse
CLICKHOUSE_DB_PORT=8123
CLICKHOUSE_DB_DATABASE=default
CLICKHOUSE_DB_USERNAME=default
CLICKHOUSE_ADMIN_PASSWORD=change-this-clickhouse-password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_DRIVER=redis
SESSION_DRIVER=redis
BROADCAST_DRIVER=redis
QUEUE_CONNECTION=sync

ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=change-this-admin-password
DEFAULT_USD_RATE=0.0125

MAIL_MAILER=log
MAIL_DRIVER=log
LOG_CHANNEL=stderr

TRADINGVIEW_LOGIN=
TRADINGVIEW_PASSWORD=
