{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "bavix/laravel-clickhouse": "^3.1",
        "cryptonator/merchant-php-sdk": "^1.0",
        "dirape/token": "^2.3",
        "guzzlehttp/guzzle": "^7.0.1",
        "ixudra/curl": "^6.21",
        "laravel/framework": "^12.71",
        "laravel/passport": "^13.11",
        "laravel/socialite": "^5.0",
        "laravel/tinker": "^2.10",
        "predis/predis": "^1.1",
        "phpseclib/phpseclib": "^4.0.3",
        "qiwi/bill-payments-php-sdk": "^0.1.2",
        "react/event-loop": "1.1.1",
        "spatie/async": "^1.4",
        "textalk/websocket": "^1.4",
        "torann/geoip": "^3.0.10",
        "twilio/sdk": "^6.10",
        "yajra/laravel-datatables-oracle": "^12.7"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16",
        "fakerphp/faker": "^1.24",
        "laravel/ui": "^4.6",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^8.8",
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "files": [
            "app/Helpers/Helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
